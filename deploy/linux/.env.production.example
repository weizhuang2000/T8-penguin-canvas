# Copy to .env.production, chmod 600, and fill values on the server.
# Never commit the filled file or paste these values into source control.
MYSQL_HOST=10.0.0.10
MYSQL_PORT=3306
MYSQL_DATABASE=design_team_db
MYSQL_USER=t8_canvas_linux
MYSQL_PASSWORD=replace-with-a-random-password
JWT_SECRET=replace-with-the-existing-secret
T8_COMFYUI_ALLOW_REMOTE=0
ALIST_IMAGE=xhofe/alist:latest

# Output storage: legacy primary files are uploaded to the active remote space
# in bounded batches. Verified local copies are retained for 7 days and cleaned
# at 04:00 Asia/Shanghai every day.
T8_OUTPUT_STORAGE_SCAN_MS=30000
T8_OUTPUT_STORAGE_BACKFILL_BATCH_SIZE=20
T8_OUTPUT_STORAGE_LOCAL_RETENTION_MS=604800000
T8_OUTPUT_STORAGE_CLEANUP_HOUR=4

# PPT workspace. Keep credentials only in the server-side .env.production (chmod 600).
T8_PPT_ENABLED=1
T8_PPT_CODEX_MODEL=
T8_PPT_CODEX_API_KEY=
T8_PPT_CODEX_TIMEOUT_S=3600
DOCKER_RUNNER_IMAGE=ppt-runner:latest
DOCKER_RUNNER_NETWORK=ppt-isolated

# LibreChat external service. The service must be deployed separately with
# MongoDB/Redis and configured to trust the T8 bridge headers.
# When T8 and LibreChat run in Docker, use LibreChat's service name on their
# shared external network. Do not point at a host-only loopback port.
T8_CODEX_SERVICE_URL=http://librechat:3080
T8_CODEX_BRIDGE_SECRET=replace-with-a-random-32-byte-secret

# syntax=docker/dockerfile:1

# Production runtime image for an already-built web bundle.  This keeps the
# server deployment package small and avoids compiling the frontend on ECS.
FROM node:22-bookworm-slim

ENV HOST=0.0.0.0 \
    PORT=18766 \
    NODE_ENV=production \
    T8PC_PACKAGED=1 \
    T8PC_FRONTEND_DIST=/app/dist \
    T8PC_USER_DATA=/app/userdata \
    HOME=/app/userdata

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY backend/package.json backend/package-lock.json ./backend/
RUN cd backend && npm ci --omit=dev

COPY backend/src ./backend/src
COPY shared ./shared
COPY tools/parsehub-bridge ./tools/parsehub-bridge
COPY dist ./dist

EXPOSE 18766
VOLUME ["/app/userdata"]

CMD ["node", "backend/src/server.js"]

# T8 LibreChat service (copy to .env.t8 and replace every placeholder)
HOST=0.0.0.0
PORT=3080
NODE_ENV=production
DOMAIN_CLIENT=http://localhost/codex
DOMAIN_SERVER=http://localhost/codex
T8_CODEX_BRIDGE_SECRET=replace-with-the-same-long-random-secret-as-T8
# T8 and LibreChat share the external Docker network declared in the compose file.
T8_CODEX_UPSTREAM_URL=http://t8-penguin-canvas:18766/api/codex/v1
T8_CODEX_DEFAULT_MODEL=gpt-4o-mini

# External services. MongoDB and Redis are intentionally not part of this compose file.
MONGO_URI=mongodb://librechat_admin:password@mongodb:27017/LibreChat?authSource=admin
USE_REDIS=true
USE_REDIS_STREAMS=true
REDIS_URI=redis://:password@redis:6379/0

# T8 is the only identity and credential provider.
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_PASSWORD_RESET=false
ALLOW_ACCOUNT_DELETION=false
ENDPOINTS=custom
NO_INDEX=true
TRUST_PROXY=1
X_FRAME_OPTIONS=off
CROSS_ORIGIN_RESOURCE_POLICY=cross-origin

# Optional external file storage. The compose file binds this directory persistently.
FILE_STRATEGY=local
